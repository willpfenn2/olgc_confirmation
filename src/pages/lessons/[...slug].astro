---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { lessons as lessonList } from '../../data/lessons';

export async function getStaticPaths() {
  const entries = await getCollection('lessons');
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'lessons'>;
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const base = import.meta.env.BASE_URL;
const homeHref = base.endsWith('/') ? base : `${base}/`;

const currentIndex = lessonList.findIndex((l) => l.slug === entry.slug);
const prev = currentIndex > 0 ? lessonList[currentIndex - 1] : null;
const next = currentIndex >= 0 && currentIndex < lessonList.length - 1 ? lessonList[currentIndex + 1] : null;
const lessonHref = (slug: string) => `${homeHref}lessons/${slug}`;
---

<BaseLayout title={`Lesson ${entry.data.order} — ${entry.data.title}`} currentSlug={entry.slug}>
  <div class="mx-auto max-w-2xl px-6 py-14 md:px-10 md:py-20">
    <nav class="mb-10 text-sm">
      <a href={homeHref} class="text-slate-500 hover:text-indigo-600 transition">
        ← Back to Home
      </a>
    </nav>

    <p class="mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-indigo-600">
      Lesson {String(entry.data.order).padStart(2, '0')}
    </p>
    <h1 class="text-4xl font-semibold tracking-tight text-slate-900 md:text-5xl">
      {entry.data.title}
    </h1>
    {entry.data.subtitle && (
      <p class="mt-4 text-xl leading-snug text-slate-600">{entry.data.subtitle}</p>
    )}
    {entry.data.scripture && (
      <p class="mt-3 text-sm italic text-slate-500">{entry.data.scripture}</p>
    )}

    <hr class="my-10 border-slate-200" />

    <article class="prose prose-slate prose-lg max-w-none prose-headings:font-semibold prose-headings:tracking-tight prose-h2:mt-12 prose-h2:text-2xl prose-h3:mt-8 prose-h3:text-xl prose-a:text-indigo-600 prose-a:no-underline hover:prose-a:underline prose-strong:text-slate-900">
      <Content />
    </article>

    <nav class="mt-16 flex items-center justify-between border-t border-slate-200 pt-8 text-sm">
      {prev && prev.published ? (
        <a href={lessonHref(prev.slug)} class="group flex flex-col text-slate-500 hover:text-indigo-600 transition">
          <span class="text-xs font-semibold uppercase tracking-wider">← Previous</span>
          <span class="mt-1 font-medium text-slate-900 group-hover:text-indigo-600">{prev.title}</span>
        </a>
      ) : <span />}
      {next && next.published ? (
        <a href={lessonHref(next.slug)} class="group ml-auto flex flex-col items-end text-right text-slate-500 hover:text-indigo-600 transition">
          <span class="text-xs font-semibold uppercase tracking-wider">Next →</span>
          <span class="mt-1 font-medium text-slate-900 group-hover:text-indigo-600">{next.title}</span>
        </a>
      ) : next ? (
        <div class="ml-auto flex flex-col items-end text-right text-slate-400">
          <span class="text-xs font-semibold uppercase tracking-wider">Up Next</span>
          <span class="mt-1 font-medium">{next.title} <span class="text-slate-400">(TBD)</span></span>
        </div>
      ) : <span />}
    </nav>
  </div>
</BaseLayout>
