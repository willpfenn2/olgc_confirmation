---
import { lessons, formatShortDate } from '../data/lessons';

interface Props {
  currentSlug?: string;
}

const { currentSlug } = Astro.props;
const base = import.meta.env.BASE_URL;
const homeHref = base.endsWith('/') ? base : `${base}/`;
const lessonHref = (slug: string) => `${homeHref}lessons/${slug}`;
const isHome = currentSlug === 'home';
---

<aside
  id="sidebar"
  class="fixed inset-y-0 left-0 z-40 flex w-72 flex-col bg-ink text-neutral-300 shadow-xl shadow-black/40 transform transition-transform duration-200 -translate-x-full md:translate-x-0 border-r border-blood-900/60"
>
  <div class="flex items-center justify-between px-6 pt-7 pb-5">
    <a href={homeHref} class="group">
      <div class="font-display font-bold uppercase text-lg leading-none tracking-[0.18em] text-white group-hover:text-blood-300 transition">
        O · L · G · C
      </div>
      <div class="mt-3 text-[10px] font-semibold uppercase tracking-[0.3em] text-blood-500">
        Confirmation
      </div>
      <div class="mt-1 font-display font-semibold uppercase text-sm tracking-[0.25em] text-neutral-400">MMXXVII</div>
    </a>
    <button
      id="sidebar-close"
      aria-label="Close sidebar"
      class="md:hidden -mr-2 rounded p-2 text-neutral-400 hover:bg-neutral-900 hover:text-white"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
      </svg>
    </button>
  </div>

  <div class="mx-6 border-t border-blood-900/50"></div>

  <nav class="flex-1 overflow-y-auto px-3 py-4 scrollbar-thin">
    <a
      href={homeHref}
      class:list={[
        'group flex items-center gap-3 rounded-sm px-3 py-2 text-sm font-medium transition',
        isHome
          ? 'bg-blood-900/40 text-white border-l-[3px] border-blood-500 pl-[9px]'
          : 'text-neutral-400 hover:bg-neutral-900 hover:text-white border-l-[3px] border-transparent',
      ]}
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" viewBox="0 0 20 20" fill="currentColor">
        <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-3a1 1 0 011-1h2a1 1 0 011 1v3a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z" />
      </svg>
      Home
    </a>

    <div class="mt-6 px-3 pb-2 text-[11px] font-semibold uppercase tracking-[0.18em] text-blood-500">
      Lessons
    </div>

    <ul class="space-y-0.5">
      {lessons.map((l) => {
        const isActive = currentSlug === l.slug;
        const numCls = 'inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-sm text-[11px] font-semibold font-serif';
        const dateStr = formatShortDate(l.date);
        if (l.clickable) {
          return (
            <li>
              <a
                href={lessonHref(l.slug)}
                class:list={[
                  'group flex items-start gap-3 rounded-sm px-3 py-2 text-sm font-medium transition',
                  isActive
                    ? 'bg-blood-900/40 text-white border-l-[3px] border-blood-500 pl-[9px]'
                    : 'text-neutral-200 hover:bg-neutral-900 hover:text-white border-l-[3px] border-transparent',
                ]}
              >
                <span class:list={[numCls, isActive ? 'bg-blood-700 text-white' : 'bg-neutral-900 text-blood-400 group-hover:bg-blood-800 group-hover:text-white']}>
                  {String(l.order).padStart(2, '0')}
                </span>
                <span class="flex flex-col pt-0.5 leading-snug min-w-0">
                  <span class="truncate">{l.title}</span>
                  <span class="mt-0.5 text-[10px] font-normal uppercase tracking-wider text-neutral-500">
                    {dateStr}
                  </span>
                </span>
              </a>
            </li>
          );
        }
        const hasTitle = l.title !== 'TBD';
        return (
          <li>
            <div class="flex items-start gap-3 rounded-sm px-3 py-2 text-sm border-l-[3px] border-transparent cursor-not-allowed">
              <span class={`${numCls} bg-neutral-950 text-neutral-700 border border-neutral-800`}>
                {String(l.order).padStart(2, '0')}
              </span>
              <span class="flex flex-col pt-0.5 leading-snug min-w-0">
                <span class={hasTitle ? 'text-neutral-400' : 'text-neutral-600 italic'}>
                  {hasTitle ? l.title : 'TBD'}
                </span>
                <span class="mt-0.5 text-[10px] font-normal uppercase tracking-wider text-neutral-600">
                  {dateStr}
                </span>
              </span>
            </div>
          </li>
        );
      })}
    </ul>
  </nav>

  <div class="border-t border-blood-900/50 px-6 py-4 text-xs text-neutral-500 font-serif italic">
    Our Lady of Good Counsel
  </div>
</aside>

<div
  id="sidebar-overlay"
  class="fixed inset-0 z-30 hidden bg-black/70 backdrop-blur-sm md:hidden"
></div>
